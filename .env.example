# ==============================================================================
# ENVIRONMENT CONFIGURATION - HYBRID SEMANTIC ATS & REFERENCE UI
# ==============================================================================

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
CHAT_APP_PORT=3000
API_PROXY=http://localhost:8000/invocations
CHAT_PROXY_TIMEOUT_SECONDS=300

# Configuration precedence (highest first): per-request API overrides > process environment variables >
# this file copied to ".env" in the project root (loaded automatically, never overrides real env vars) > code defaults.
# Copy to .env:  Copy-Item .env.example .env     (PowerShell)
#
# Scoring Weights. Components that do not apply to a JD (e.g. no experience minimum, no certification requirement)
# or are unavailable (semantic model missing) are EXCLUDED and the remaining weights are renormalised, so the
# weights need not sum to 1. DEFAULTS BELOW ARE UNCHANGED AND UNVALIDATED against labelled data.
# A previously PROPOSED (also unvalidated) alternative profile - not enabled:
#   SEMANTIC_WEIGHT=0.35  BM25_WEIGHT=0.20  SKILL_WEIGHT=0.27  EXPERIENCE_WEIGHT=0.10  CERTIFICATION_WEIGHT=0.08
SEMANTIC_WEIGHT=0.40
BM25_WEIGHT=0.27
SKILL_WEIGHT=0.15
EXPERIENCE_WEIGHT=0.10
CERTIFICATION_WEIGHT=0.08

# Semantic degraded mode: false (default) = FAIL with HTTP 503 if the embedding model cannot be loaded.
# true = exclude the semantic component, renormalise, and flag every result degraded=true (not comparable with full scores).
ALLOW_DEGRADED_SEMANTIC=false

# Long-text chunking before embedding (all-MiniLM-L6-v2 truncates at ~256 word-pieces) and heuristic cosine calibration
CHUNK_MAX_WORDS=180
CHUNK_OVERLAP_WORDS=30
MAX_CHUNKS_PER_SECTION=8
SEMANTIC_COSINE_FLOOR=0.15
SEMANTIC_COSINE_CEIL=0.70

# Section-Level Semantic Weights
SECTION_WEIGHT_SKILLS=0.40
SECTION_WEIGHT_EXPERIENCE=0.30
SECTION_WEIGHT_PROJECTS=0.20
SECTION_WEIGHT_EDUCATION=0.10

# Embedding & Vector Search Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DIMENSION=384

# Vector DB - Qdrant (Leave QDRANT_URL blank for free local in-memory/embedded storage)
# For Qdrant Cloud Free Tier, set:
# QDRANT_URL=https://<your-cluster-id>.us-east-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=<your-qdrant-free-tier-api-key>
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=resumes_collection

# Supabase Configuration (Backend Resume Storage & Postgres Persistence - Batch 1)
# Keep SUPABASE_SERVICE_KEY strictly confidential on backend; never expose to frontend or git.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# Admin token for destructive operations (DELETE /api/candidates/{id}) - Batch 2
# Set as a secret on the HF Space backend dashboard. Never commit a real value here.
# The Render Node.js proxy must forward: Authorization: Bearer <ATS_ADMIN_TOKEN>
# when proxying DELETE requests to the Python backend (required for Batch 3 candidate UI).
# If unset, the DELETE endpoint returns 503 (disabled) rather than allowing unauthenticated access.
ATS_ADMIN_TOKEN=

# Metadata Database (Leave blank to use free local SQLite at data/ats_metadata.db)
# For Neon/Supabase PostgreSQL Free Tier, set:
# DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Databricks Deployment Settings (Required only when deploying via Databricks Asset Bundles)
DATABRICKS_HOST=https://<your-workspace-instance>.cloud.databricks.com
DATABRICKS_CONFIG_PROFILE=DEFAULT
DATABRICKS_APP_NAME=agent-resume-screening
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
MLFLOW_EXPERIMENT_ID=

# Missing/not-applicable CERTIFICATION/SKILL criteria: neutral_imputation (default; mathematically the same as renormalising the
# active weights) | legacy (old 0.60 cert baseline, free 0.5 preferred-skill credit, certification/skills always weighted).
# Experience is never imputed or defaulted under either policy: no minimum in the JD => component excluded.
# BEST_AVAILABLE_K: if nobody reaches SHORTLIST_THRESHOLD, the top-K eligible candidates by actual score are marked
# 'Best Available Match' for human review (scores are never altered).
NA_POLICY=neutral_imputation
BEST_AVAILABLE_K=5

# BM25 query construction: structured (default = baseline) | filtered (also removes generic boilerplate words such as
# "stakeholders", "fast-paced", "motivated" from free responsibility text; parsed skills are never removed).
# NOT validated against human-labelled relevance data - see reports/BM25_QUERY_STRATEGY_REPORT.md
BM25_QUERY_MODE=structured
